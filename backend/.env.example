# Environment
NODE_ENV=development
PORT=3000

# MongoDB Atlas (required) — never commit real credentials
# Cluster: constantino-db.mhqi5ii.mongodb.net
# Network Access must allow your IP and Render (0.0.0.0/0)
MONGODB_URI=mongodb+srv://USER:PASSWORD@constantino-db.mhqi5ii.mongodb.net/constantino?retryWrites=true&w=majority&appName=constantino-db

# Auth
JWT_SECRET=constantino-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# CORS (comma-separated)
CORS_ORIGIN=http://localhost:4300,http://localhost:4200,capacitor://localhost,http://localhost

# Frontend URL
FRONTEND_URL=http://localhost:4300

# Cron / recorrentes
CRON_SECRET=constantino-cron-secret
ENABLE_CRON=true
