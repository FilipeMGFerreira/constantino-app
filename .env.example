# MongoDB Atlas — paste into backend/.env as MONGODB_URI
# Cluster: constantino-db.mhqi5ii.mongodb.net
#
# Checklist Atlas:
# 1. Database Access → user with read/write
# 2. Network Access → 0.0.0.0/0 (Render) + o teu IP (dev)
# 3. Replace USER and PASSWORD (URL-encode special chars, e.g. @ → %40)
# 4. On Render → constantino-api → Environment → MONGODB_URI (never commit secrets)

MONGODB_URI=mongodb+srv://USER:PASSWORD@constantino-db.mhqi5ii.mongodb.net/constantino?retryWrites=true&w=majority&appName=constantino-db
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:4300
FRONTEND_URL=http://localhost:4300
CRON_SECRET=change-me-cron
